  /* ════════════════════════════════
     ABOUT SECTION
     ════════════════════════════════ */

  /*
   * Mobile: #about is rendered by SectionWrapper so Astro's scoped styles
   * can't reach it — :global() is required. We strip snap + overflow so the
   * element is NOT a scroll container (overflow:hidden creates one), letting
   * the inner panes register their own snap points against <html>.
   */
  @media (max-width: 1023px) {
    :global(#about) {
      min-height: unset;
      scroll-snap-align: none;
      overflow: visible;
    }
    .about-bio-pane,
    .about-members-pane {
      min-height: 100dvh;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      background-color: var(--color-bg-deep);
    }
  }

  /* Bio pane */
  .about-bio-pane {
    display: flex;
    flex-direction: column;
