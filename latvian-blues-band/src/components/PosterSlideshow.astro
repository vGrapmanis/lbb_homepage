---
import { readdir } from 'fs/promises';
import path from 'path';

const postersDir = path.resolve('public/images/posters');
const files = await readdir(postersDir);
const posters = files
  .filter(f => /\.(jpe?g|png|webp)$/i.test(f))
  .sort()
  .map(f => `/images/posters/${f}`);
---

<div class="slideshow" id="poster-slideshow" aria-roledescription="carousel" aria-label="Upcoming event posters">

  <!-- Slides -->
  <div class="slides">
    {posters.map((src, i) => (
      <div
        class={`slide${i === 0 ? ' slide--active' : ''}`}
        role="group"
        aria-roledescription="slide"
        aria-label={`Poster ${i + 1} of ${posters.length}`}
        aria-hidden={i !== 0}
        data-index={i}
      >
        <img
          src={src}
          alt={`Event poster ${i + 1}`}
          class="slide-img"
          loading={i === 0 ? 'eager' : 'lazy'}
          draggable="false"
        />
      </div>
    ))}
  </div>

  <!-- Prev / Next arrows (desktop) -->
  <button class="arrow arrow--prev" id="slide-prev" aria-label="Previous poster">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>
  <button class="arrow arrow--next" id="slide-next" aria-label="Next poster">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>

  <!-- Dot indicators -->
  <div class="dots" role="tablist" aria-label="Poster navigation">
    {posters.map((_, i) => (
      <button
        class={`dot${i === 0 ? ' dot--active' : ''}`}
        role="tab"
        aria-label={`Go to poster ${i + 1} of ${posters.length}`}
        aria-selected={i === 0}
        data-dot={i}
      />
    ))}
  </div>

  <!-- Scroll hint -->
  <div class="scroll-hint" aria-hidden="true">
    <span class="scroll-hint-line"></span>
  </div>
</div>

<style>
  .slideshow {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    background:
      radial-gradient(ellipse 80% 60% at 60% 40%, #2a1a0a 0%, transparent 70%),
      radial-gradient(ellipse 50% 80% at 20% 80%, #1a0d0d 0%, transparent 60%),
      linear-gradient(135deg, #0A0A0F 0%, #1a1025 40%, #0e0a1a 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Slides ── */
  .slides {
    position: absolute;
    inset: 0;
  }

  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .slide--active {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }

  .slide-img {
    max-width: 100%;
    max-height: 100vh;
    max-height: 100dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    padding: 64px 0 80px; /* clear navbar top, dots bottom */
    box-sizing: border-box;
    user-select: none;
  }

  /* ── Arrows ── */
  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(10, 10, 15, 0.45);
    border: 1px solid rgba(196, 132, 45, 0.2);
    border-radius: 50%;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text-primary);
    opacity: 0.4;
    transition: opacity 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  }

  .arrow--prev { left: 1.25rem; }
  .arrow--next { right: 1.25rem; }

  @media (hover: hover) {
    .arrow:hover {
      opacity: 1;
      background: rgba(10, 10, 15, 0.75);
      border-color: var(--color-accent);
    }
  }

  .arrow:focus-visible {
    opacity: 1;
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Hide arrows on small screens — rely on swipe */
  @media (max-width: 640px) {
    .arrow { display: none; }
  }

  /* ── Dots ── */
  .dots {
    position: absolute;
    bottom: 3.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid rgba(196, 132, 45, 0.5);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    /* Larger hit area */
    position: relative;
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .dot--active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: scale(1.25);
  }

  .dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* ── Scroll hint ── */
  .scroll-hint {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
  }

  @media (max-height: 520px) {
    .scroll-hint { display: none; }
  }

  .scroll-hint-line {
    display: block;
    width: 1px;
    height: 36px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    animation: scroll-drop 2s ease-in-out infinite;
  }

  @keyframes scroll-drop {
    0%   { opacity: 0; transform: translateY(-10px); }
    25%  { opacity: 1; }
    75%  { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint-line { animation: none; opacity: 0.5; }
  }
</style>

<script>
  const slideshow = document.getElementById('poster-slideshow')!;
  const slides    = Array.from(slideshow.querySelectorAll<HTMLElement>('.slide'));
  const dots      = Array.from(slideshow.querySelectorAll<HTMLElement>('.dot'));
  const prevBtn   = slideshow.querySelector<HTMLButtonElement>('#slide-prev')!;
  const nextBtn   = slideshow.querySelector<HTMLButtonElement>('#slide-next')!;

  const total = slides.length;
  let current = 0;
  let timer: ReturnType<typeof setInterval> | null = null;

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function goTo(index: number) {
    slides[current].classList.remove('slide--active');
    slides[current].setAttribute('aria-hidden', 'true');
    dots[current].classList.remove('dot--active');
    dots[current].setAttribute('aria-selected', 'false');

    current = (index + total) % total;

    slides[current].classList.add('slide--active');
    slides[current].setAttribute('aria-hidden', 'false');
    dots[current].classList.add('dot--active');
    dots[current].setAttribute('aria-selected', 'true');
  }

  function next() { goTo(current + 1); }
  function prev() { goTo(current - 1); }

  function startTimer() {
    if (reducedMotion) return;
    if (timer) clearInterval(timer);
    timer = setInterval(next, 5000);
  }

  function resetTimer() {
    startTimer();
  }

  // Arrow buttons
  prevBtn.addEventListener('click', () => { prev(); resetTimer(); });
  nextBtn.addEventListener('click', () => { next(); resetTimer(); });

  // Dot buttons
  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.dataset.dot);
      goTo(idx);
      resetTimer();
    });
  });

  // Keyboard
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  { prev(); resetTimer(); }
    if (e.key === 'ArrowRight') { next(); resetTimer(); }
  });

  // Touch swipe
  let touchStartX = 0;
  slideshow.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });

  slideshow.addEventListener('touchend', (e) => {
    const delta = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(delta) > 50) {
      delta > 0 ? next() : prev();
      resetTimer();
    }
  }, { passive: true });

  // Pause on hover
  slideshow.addEventListener('mouseenter', () => {
    if (timer) clearInterval(timer);
  });
  slideshow.addEventListener('mouseleave', () => {
    startTimer();
  });

  startTimer();
</script>
