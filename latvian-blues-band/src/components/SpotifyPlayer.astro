---
interface Props {
  /** Spotify artist ID — replace with real ID from open.spotify.com/artist/ARTIST_ID */
  artistId?: string;
  /** Alternatively, embed a specific album or playlist: 'album', 'playlist', 'track' */
  type?: "artist" | "album" | "playlist" | "track";
  /** ID for the alternative embed type */
  id?: string;
  height?: number;
}

const {
  artistId = "1qMnpBrWo9j6mgz4dCIKoS?utm_source=generator",
  type = "artist",
  id,
  height = 352,
} = Astro.props;

const embedId = id ?? artistId;
const embedType = id ? type : "artist";
const src = `https://open.spotify.com/embed/artist/1qMnpBrWo9j6mgz4dCIKoS?utm_source=generator`;
---

<div class="spotify-wrapper">
  <iframe
    src={src}
    width="100%"
    frameborder="0"
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
    title="Latvian Blues Band on Spotify"
    style="border-radius: 12px;"></iframe>
</div>

<style>
  .spotify-wrapper {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    height: 352px;
  }

  .spotify-wrapper iframe {
    height: 100%;
  }

  @media (max-width: 767px) {
    .spotify-wrapper {
      height: 370px;
    }
  }
</style>
