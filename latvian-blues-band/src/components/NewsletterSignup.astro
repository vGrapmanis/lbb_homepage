---
// Mailchimp embedded form.
// Owner must replace USER_ID and LIST_ID after creating a Mailchimp audience.
// Go to: Audience → Signup forms → Embedded forms → copy the form action URL.
const MAILCHIMP_ACTION = 'https://latvianbluesband.usX.list-manage.com/subscribe/post?u=USER_ID&amp;id=LIST_ID';
---

<div class="newsletter">
  <p class="newsletter-label">Stay in the loop</p>
  <p class="newsletter-sub">
    Be the first to know what's new. Unsubscribe any time.
  </p>

  <form
    action={MAILCHIMP_ACTION}
    method="POST"
    target="_blank"
    class="newsletter-form"
    id="newsletter-form"
    novalidate
  >
    <!-- Mailchimp honeypot — hidden from real users, catches bots -->
    <div style="position:absolute;left:-5000px;" aria-hidden="true">
      <input type="text" name="b_USER_ID_LIST_ID" tabindex="-1" value="" autocomplete="off" />
    </div>

    <div class="newsletter-row">
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        type="email"
        name="EMAIL"
        placeholder="your@email.com"
        required
        autocomplete="email"
        class="newsletter-input"
        aria-label="Email address"
      />
      <button type="submit" class="btn newsletter-btn" data-ga-event="newsletter_signup">
        Join
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-left:0.4rem;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>
    </div>
    <p class="newsletter-consent">
      By subscribing you agree to our <a href="/privacy" class="consent-link">Privacy Policy</a>.
    </p>
  </form>
</div>

<style>
  .newsletter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    width: 100%;
    max-width: 480px;
  }

  .newsletter-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .newsletter-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-text-primary);
  }

  .newsletter-sub {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .newsletter-form {
    width: 100%;
    position: relative;
  }

  .newsletter-row {
    display: flex;
    gap: 0.5rem;
    width: 100%;
  }

  .newsletter-input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 1rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    color: var(--color-text-primary);
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.9rem;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    min-height: 44px;
  }

  .newsletter-input::placeholder {
    color: var(--color-text-muted);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(196, 132, 45, 0.15);
  }

  .newsletter-btn {
    flex-shrink: 0;
    padding: 0.75rem 1.5rem;
    font-size: 0.8rem;
  }

  /* Mobile: stack input + button */
  @media (max-width: 400px) {
    .newsletter-row {
      flex-direction: column;
    }
    .newsletter-btn {
      width: 100%;
    }
  }

  .newsletter-consent {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    text-align: center;
  }

  .consent-link {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .consent-link:hover {
    color: var(--color-accent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>
