---
interface Props {
  title: string;
  year: number;
  cover: string;
  spotifyUrl?: string;
  deezerUrl?: string;
  youtubeUrl?: string;
}

const { title, year, cover, spotifyUrl, deezerUrl, youtubeUrl } = Astro.props;

const links = [
  spotifyUrl && { href: spotifyUrl, label: 'Spotify', icon: 'spotify' },
  deezerUrl  && { href: deezerUrl,  label: 'Deezer',  icon: 'deezer'  },
  youtubeUrl && { href: youtubeUrl, label: 'YouTube', icon: 'youtube' },
].filter(Boolean) as { href: string; label: string; icon: string }[];
---

<article class="disc-card">
  <div class="disc-cover-wrap">
    <img
      src={cover}
      alt={`${title} — album cover`}
      class="disc-cover"
      width="300"
      height="300"
      loading="lazy"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
    />
    <!-- Fallback placeholder shown when image missing -->
    <div class="disc-cover-placeholder" aria-hidden="true" style="display:none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3">
        <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/>
      </svg>
    </div>

    <div class="disc-overlay" aria-hidden="true"></div>
  </div>

  <div class="disc-info">
    <div class="disc-title-row">
      <span class="disc-year">{year}</span>
      <h3 class="disc-title">{title}</h3>
    </div>

    {links.length > 0 && (
      <ul class="disc-links" role="list">
        {links.map(link => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="disc-link"
              aria-label={`Listen to ${title} on ${link.label}`}
            >
              {link.icon === 'spotify' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
              )}
              {link.icon === 'deezer' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.944 16.412H24v1.641h-5.056zm0-2.725H24v1.641h-5.056zm0-2.724H24v1.64h-5.056zM0 16.412h5.056v1.641H0zm6.472 0h5.056v1.641H6.472zm6.472 0H18v1.641h-5.056zm-6.472-2.725h5.056v1.641H6.472zm6.472 0H18v1.641h-5.056zm-6.472-2.724h5.056v1.64H6.472zm6.472 0H18v1.64h-5.056zm-6.472-2.725h5.056v1.641H6.472zm6.472 0H18v1.641h-5.056zm0-2.724H18v1.64h-5.056z"/></svg>
              )}
              {link.icon === 'youtube' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
              )}
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  /* Horizontal card — image stretches to full card height (square), info on right */
  .disc-card {
    display: flex;
    flex-direction: row;
    height: 100%;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-left: 3px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    transition:
      border-left-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease,
      background 0.3s ease;
  }

  @media (hover: hover) {
    .disc-card:hover {
      border-left-color: var(--color-accent);
      transform: translateX(3px);
      box-shadow: -3px 0 16px rgba(196, 132, 45, 0.15), 0 4px 16px rgba(0,0,0,0.3);
      background: color-mix(in srgb, var(--color-bg-elevated) 95%, var(--color-accent) 5%);
    }

    .disc-card:hover .disc-cover {
      transform: scale(1.06);
      filter: brightness(1.1);
    }

    .disc-card:hover .disc-overlay {
      opacity: 1;
    }
  }

  /* Square cover: stretches to full card height, width = height via aspect-ratio */
  .disc-cover-wrap {
    position: relative;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
    align-self: stretch;
    overflow: hidden;
    background: var(--color-bg-surface);
  }

  .disc-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  .disc-cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    background: var(--color-bg-surface);
  }

  .disc-overlay {
    position: absolute;
    inset: 0;
    background: rgba(196, 132, 45, 0.06);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* Info panel — fills remaining width */
  .disc-info {
    flex: 1;
    min-width: 0;
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
  }

  .disc-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-width: 0;
  }

  .disc-year {
    font-size: 0.75rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    font-weight: 600;
    flex-shrink: 0;
  }

  .disc-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1rem, 2vw, 1.4rem);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  /* Streaming links — icon + label pill row */
  .disc-links {
    list-style: none;
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .disc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    height: 30px;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .disc-link svg { flex-shrink: 0; }

  @media (hover: hover) {
    .disc-link:hover {
      color: var(--color-accent);
      border-color: var(--color-accent);
      background: rgba(196, 132, 45, 0.08);
    }
  }

  /* Mobile: keep streaming buttons on one line with tighter sizing */
  @media (max-width: 559px) {
    .disc-card {
      min-height: 80px;
    }

    .disc-links {
      flex-wrap: nowrap;
      gap: 0.35rem;
      margin-top: 0.35rem;
    }

    .disc-link {
      padding: 0.25rem 0.45rem;
      height: 26px;
      font-size: 0.65rem;
      gap: 0.25rem;
    }

    .disc-link svg {
      width: 12px;
      height: 12px;
    }
  }

  /* Wide layout: year + title + streaming buttons all on one line */
  @media (min-width: 600px) {
    .disc-info {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 1.5rem;
    }

    .disc-title-row {
      flex: 1 1 auto;
      min-width: 0;
    }

    .disc-links {
      flex-shrink: 0;
      flex-wrap: nowrap;
      margin-top: 0;
    }
  }
</style>
